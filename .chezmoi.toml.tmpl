{{- /* Git identity: reuse an existing global git config when present, prompt only for what is missing */ -}}
{{- $name := "" -}}
{{- $email := "" -}}
{{- $signingkey := "" -}}
{{- if lookPath "git" -}}
{{-   $name = output "git" "config" "--global" "--default" "" "--get" "user.name" | trim -}}
{{-   $email = output "git" "config" "--global" "--default" "" "--get" "user.email" | trim -}}
{{-   $signingkey = output "git" "config" "--global" "--default" "" "--get" "user.signingkey" | trim -}}
{{- end -}}
{{- if not $name -}}{{- $name = promptStringOnce . "name" "Git author name" .chezmoi.username -}}{{- end -}}
{{- if not $email -}}{{- $email = promptStringOnce . "email" "Git email" -}}{{- end -}}
{{- if not $signingkey -}}{{- $signingkey = promptStringOnce . "signingkey" "GPG signing key ID (empty = no signing)" -}}{{- end -}}
[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    signingkey = {{ $signingkey | quote }}
{{- if eq .chezmoi.os "darwin" }}
    os = "macos"
{{- else if eq .chezmoi.os "linux" }}
    {{- if or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "pop") }}
    os = "ubuntu"
    {{- else if or (eq .chezmoi.osRelease.id "arch") (eq (index .chezmoi.osRelease "idLike" | default "") "arch") }}
    os = "arch"
    {{- else }}
    os = "linux"
    {{- end }}
{{- end }}

[edit]
    command = "nvim"

[diff]
    pager = "less -R"
