#!/bin/bash
set -e

echo "=== Installing base system packages ==="

{{ if eq .chezmoi.os "linux" }}
{{ if or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "pop") }}

# Update package lists
sudo apt update

# Install essential packages
PACKAGES=(
    curl
    wget
    git
    unzip
    build-essential
    software-properties-common
    apt-transport-https
    ca-certificates
    gnupg
    lsb-release
    jq
    ripgrep
    fd-find
    fzf
    tmux
    htop
    git-delta
)

for pkg in "${PACKAGES[@]}"; do
    if dpkg -l "$pkg" &> /dev/null; then
        echo "✓ $pkg already installed"
    else
        echo "Installing $pkg..."
        sudo apt install -y "$pkg"
    fi
done

{{ else if or (eq .chezmoi.osRelease.id "arch") (eq (index .chezmoi.osRelease "idLike" | default "") "arch") }}

# Arch / CachyOS
# Refresh the package database and upgrade first (equivalent of apt update).
# Installing from a stale database gives 404s on the mirrors, and installing
# without upgrading is a partial upgrade, which breaks Arch systems.
sudo pacman -Syu --noconfirm

# --needed skips packages that are already installed
sudo pacman -S --needed --noconfirm \
    curl \
    wget \
    git \
    unzip \
    base-devel \
    gnupg \
    jq \
    ripgrep \
    fd \
    fzf \
    tmux \
    htop \
    git-delta \
    wl-clipboard

{{ end }}
{{ else if eq .chezmoi.os "darwin" }}

# Check for Homebrew
if ! command -v brew &> /dev/null; then
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Install essential packages
PACKAGES=(
    curl
    wget
    git
    unzip
    jq
    ripgrep
    fd
    fzf
    tmux
    htop
    git-delta
    gnupg
    pinentry-mac
)

for pkg in "${PACKAGES[@]}"; do
    if brew list "$pkg" &> /dev/null; then
        echo "✓ $pkg already installed"
    else
        echo "Installing $pkg..."
        brew install "$pkg"
    fi
done

{{ end }}

echo "✓ Base packages installed successfully"
