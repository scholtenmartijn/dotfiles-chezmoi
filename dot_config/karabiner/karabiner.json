{
  "profiles": [
    {
      "name": "Default profile",
      "complex_modifications": {
        "rules": [
          {
            "description": "Ctrl+C/V/X to Cmd+C/V/X everywhere (Linux-style copy/paste/cut)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "c",
                  "modifiers": {
                    "mandatory": ["left_control"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "c",
                    "modifiers": ["left_command"]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "v",
                  "modifiers": {
                    "mandatory": ["left_control"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "v",
                    "modifiers": ["left_command"]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "x",
                  "modifiers": {
                    "mandatory": ["left_control"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "x",
                    "modifiers": ["left_command"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Ctrl+Space to Cmd+Space (Spotlight/search)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "spacebar",
                  "modifiers": {
                    "mandatory": ["left_control"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "spacebar",
                    "modifiers": ["left_command"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Cmd+C to Ctrl+C in terminals (SIGINT to stop processes)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "c",
                  "modifiers": {
                    "mandatory": ["left_command"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "c",
                    "modifiers": ["left_control"]
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.apple\\.Terminal$",
                      "^com\\.googlecode\\.iterm2$",
                      "^org\\.alacritty$",
                      "^net\\.kovidgoyal\\.kitty$",
                      "^com\\.mitchellh\\.ghostty$"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "selected": true
    }
  ]
}
