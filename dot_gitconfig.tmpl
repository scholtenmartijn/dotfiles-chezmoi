[user]
    name = {{ .chezmoi.username }}
    # email = your.email@example.com
    # signingkey = YOUR_GPG_KEY_ID

[core]
    editor = nvim
    autocrlf = input
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[merge]
    conflictstyle = diff3
    tool = nvimdiff

[mergetool]
    prompt = false

[diff]
    colorMoved = default
    tool = nvimdiff

[difftool]
    prompt = false

[commit]
    # gpgsign = true

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    unstage = reset HEAD --
    last = log -1 HEAD
    lg = log --oneline --graph --decorate
    df = diff
    dfs = diff --staged

[color]
    ui = auto

[credential]
{{ if eq .chezmoi.os "darwin" }}
    helper = osxkeychain
{{ else }}
    helper = store
{{ end }}
