[user]
    name = {{ .name }}
    email = {{ .email }}
{{- if .signingkey }}
    signingkey = {{ .signingkey }}
{{- end }}

[core]
    editor = nvim
    autocrlf = input
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[merge]
    conflictstyle = diff3
    tool = nvimdiff

[mergetool]
    prompt = false

[diff]
    colorMoved = default
    tool = nvimdiff

[difftool]
    prompt = false

{{ if .signingkey -}}
[commit]
    gpgsign = true

[tag]
    gpgsign = true

[gpg]
    program = gpg
{{- end }}

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    unstage = reset HEAD --
    last = log -1 HEAD
    lg = log --oneline --graph --decorate
    df = diff
    dfs = diff --staged

[color]
    ui = auto

# Always talk to GitHub over SSH, even when a remote was cloned/added as https
[url "git@github.com:"]
    insteadOf = https://github.com/

[credential]
{{ if eq .chezmoi.os "darwin" }}
    helper = osxkeychain
{{ else }}
    helper = store
{{ end }}
