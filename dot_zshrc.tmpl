# Enable Powerlevel10k instant prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="powerlevel10k/powerlevel10k"

# Plugins
plugins=(
    git
    kubectl
    kubectx
    docker
    terraform
    aws
    azure
    command-not-found
    fzf-zsh-plugin
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# User configuration

# PATH additions
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"

# Editor
export EDITOR='nvim'
export VISUAL='nvim'

# Aliases - Core
alias v='nvim'
alias k='kubectl'

# Aliases - Kubernetes
alias kgp='kubectl get pods'
alias kgs='kubectl get svc'
alias kgd='kubectl get deployments'
alias kga='kubectl get all'
alias kl='kubectl logs'
alias klf='kubectl logs -f'
alias kdesc='kubectl describe'
alias kctx='kubectx'
alias kns='kubens'
alias kaf='kubectl apply -f'
alias kdf='kubectl delete -f'

# Aliases - Terraform
alias tf='terraform'
alias tfa='terraform apply'
alias tfp='terraform plan'
alias tfi='terraform init'
alias tfd='terraform destroy'

# Aliases - Docker
alias dc='docker compose'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias di='docker images'
alias dex='docker exec -it'

# Aliases - Azure
alias azl='az login'
alias azal='az account list'
alias azas='az account set'

# Aliases - AWS
alias awsp='aws --profile'

# Aliases - Git (additional)
alias gst='git status'
alias gco='git checkout'
alias gcm='git commit -m'
alias gp='git push'
alias gpl='git pull'
alias glog='git log --oneline --graph'

# Aliases - General
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'

{{ if eq .chezmoi.os "linux" }}
# Linux-specific
alias pbcopy='xclip -selection clipboard'
alias pbpaste='xclip -selection clipboard -o'
alias fd='fdfind'
{{ end }}

# FZF configuration
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
export FZF_CTRL_R_OPTS='--sort --exact'

{{ if eq .chezmoi.os "linux" }}
# fzf-zsh-plugin doesn't handle apt-installed fzf, source key bindings explicitly
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
{{ end }}

# Load Powerlevel10k config
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Kubectl completion
[[ $commands[kubectl] ]] && source <(kubectl completion zsh)

# Azure CLI completion
[[ -f /etc/bash_completion.d/azure-cli ]] && source /etc/bash_completion.d/azure-cli

# AWS CLI completion
complete -C '/usr/local/bin/aws_completer' aws
